{
    "name": "wittygekko/laravel-sbu-connector",
    "version": "1.0.0",
    "description": "Signed, versioned operation connector for WittyGekko SBU Laravel applications.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.3",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "WittyGekko\\SbuConnector\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "WittyGekko\\SbuConnector\\SbuConnectorServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
